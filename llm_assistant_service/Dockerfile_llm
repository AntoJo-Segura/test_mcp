# Use an official Python runtime as a parent image
FROM python:3.9-slim

# Set the working directory in the container
WORKDIR /app_llm

# Copy the requirements file into the container at /app_llm
COPY requirements.txt .

# Install any needed packages specified in requirements.txt
# This is where 'pip install mcp' will be attempted during Docker build.
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application file into the container at /app_llm
COPY app_llm.py .

# Note: This Dockerfile assumes leads.csv will be made available via a volume mount
# at /csv_data/leads.csv when the container is run, as app_llm.py expects it there.

# EXPOSE 5001
# Port exposure is not strictly necessary if using stdio transport primarily.
# If an MCP HTTP transport is used in the future, this should be uncommented/adjusted.

# Define environment variable for any MCP specific configurations if needed in future
# ENV FLASK_APP=app_llm.py # No longer Flask
# ENV FLASK_RUN_HOST=0.0.0.0
# ENV FLASK_RUN_PORT=5001

# Run app_llm.py when the container launches.
# This will start the MCP server listening on stdio.
CMD ["python", "app_llm.py"]
